{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kabootar",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": { "enabled": true },

  // The PWA built by Vite. Unknown paths fall back to index.html; API and
  // websocket paths go to the worker first.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*", "/healthz"]
  },

  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "DIRECTORY", "class_name": "Directory" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "Directory"] }],

  "vars": {
    "MAX_PEERS": "8",
    "ROOM_TTL_HOURS": "24",
    "MASTER_GRACE_SECONDS": "300",
    "STUN_URLS": "stun:stun.cloudflare.com:3478,stun:stun.l.google.com:19302"
  }

  // Secrets (wrangler secret put …):
  //   SERVER_SECRET       required: derives room keys
  //   CF_TURN_KEY_ID      optional: Cloudflare Realtime TURN key id
  //   CF_TURN_API_TOKEN   optional: Cloudflare Realtime TURN API token
  //
  // Custom domain, e.g.:
  // "routes": [{ "pattern": "kabootar.example.com", "custom_domain": true }]
}
