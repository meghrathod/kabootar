{
  "name": "@kabootar/fe",
  "version": "0.0.0",
  "description": "",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "signalling:build": "cd signalling && go build -o out/rendezvous ./cmd/signalling",
    "signalling:start": "cd signalling && ./out/rendezvous",
    "signalling:start:bg": "sh -c 'cd signalling && ./out/rendezvous >/tmp/kabootar-signalling.log 2>&1 & echo $! > /tmp/kabootar-signalling.pid && echo PID $(cat /tmp/kabootar-signalling.pid)'",
    "signalling:stop": "sh -c 'test -f /tmp/kabootar-signalling.pid && kill $(cat /tmp/kabootar-signalling.pid) && rm -f /tmp/kabootar-signalling.pid || echo signalling not running'",
    "signalling:logs": "tail -f /tmp/kabootar-signalling.log",
    "signalling:build-run": "yarn signalling:build && yarn signalling:start",
    "signalling:build-run:bg": "yarn signalling:build && yarn signalling:start:bg",
    "build:all": "yarn signalling:build && yarn build",
    "run:all": "yarn signalling:start:bg && yarn dev"
  },
  "license": "Private",
  "devDependencies": {
    "@types/node": "^18.11.5",
    "@types/qrcode-svg": "^1.1.1",
    "@types/wicg-file-system-access": "^2020.9.5",
    "autoprefixer": "^10.4.8",
    "postcss": "^8.4.16",
    "tailwindcss": "^3.1.8",
    "typescript": "^4.8.2",
    "vite": "^3.0.9",
    "vite-plugin-bundled-entry": "^0.3.1",
    "vite-plugin-solid": "^2.3.0"
  },
  "dependencies": {
    "@solid-primitives/map": "^0.2.3",
    "@solidjs/meta": "^0.28.0",
    "@solidjs/router": "^0.5.0",
    "@tailwindcss/line-clamp": "^0.4.2",
    "qrcode-svg": "^1.1.0",
    "solid-headless": "^0.13.0",
    "solid-js": "^1.5.1"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
